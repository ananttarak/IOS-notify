rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: only the owner can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Schedule config: only the owner can read or write
    match /schedules/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Templates: owner-scoped access
    match /templates/{templateId} {
      allow read, write: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Devices: authenticated device registration
    match /devices/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // History: owner-scoped read and write
    match /history/{historyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Metrics: owner-scoped read, backend writes
    match /metrics/{metricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
