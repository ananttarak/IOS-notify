# StorePulse Backend Environment Configuration
PORT=3000

# Set to true to start the persistent background polling loop automatically on server boot
AUTO_START_SCHEDULER=true

# Firebase Service Account JSON (Minified string)
# Leave blank to use GOOGLE_APPLICATION_CREDENTIALS environment variable
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional Firebase Project ID override
FIREBASE_PROJECT_ID="ios-shopify-nofiy"
